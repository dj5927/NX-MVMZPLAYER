{
  "name": "mvmz-hos-universal-player",
  "version": "1.0.10",
  "private": true,
  "description": "Universal RPG Maker MV/MZ player runtime for Nintendo Switch HOS using nx.js",
  "license": "MIT",
  "scripts": {
    "build": "npx --no-install esbuild --bundle --sourcemap --sources-content=false --target=es2022 --format=esm --outfile=romfs/main.js src/main.ts",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "nro": "npm run build && node ../node_modules/@nx.js/nro/dist/main.js --fat"
  },
  "dependencies": {
    "@nx.js/constants": "0.4.1"
  },
  "devDependencies": {
    "@nx.js/nro": "1.0.0-beta.6",
    "@nx.js/runtime": "1.0.0-beta.6",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3"
  }
}
